# ==========================================
# JUS DIGITAL - BACKEND ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to Git!

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jus_digital?schema=public"

# JWT Authentication
JWT_SECRET="replace-with-a-strong-random-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Allows testing the flow locally before setting up Google Cloud Console (only works when NODE_ENV !== 'production')
ENABLE_DEV_LOGIN="true"

# OpenAI Integration (Model: gpt-4o-mini)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# AWS S3 Storage
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="jus-digital-documents"
# Optional: Set AWS_S3_ENDPOINT only when using local MinIO/LocalStack in Docker Compose.
# Leave empty or commented out when using real AWS S3.
# AWS_S3_ENDPOINT="http://localhost:9000"
# AWS_S3_FORCE_PATH_STYLE="true"
